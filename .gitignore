## ===================================================================
## Zameel (.NET 10 Solution) .gitignore
## ===================================================================

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# User-specific & local runtime uploads
src/Zameel.Web/wwwroot/uploads/*
!src/Zameel.Web/wwwroot/uploads/.gitkeep

# Local database files
*.mdf
*.ldf
*.ndf
*.db
*.sqlite
*.sqlite3

# Local settings and secrets
appsettings.Development.json
appsettings.Local.json
*.local.json

# Temporary scripts & test artifacts
scratch/
*.tmp
*.temp
*_cookie.txt
cookies.txt

# Operating System files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Entity Framework generated migrations bundle
bundle/
efbundle.exe
