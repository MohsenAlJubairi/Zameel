@model UserProfileDto
@{
    ViewData["Title"] = "الملف الأكاديمي والكوتا";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-7">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 border-0 shadow-xs">
                ✅ @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 shadow-xs">
                ⚠️ @TempData["ErrorMessage"]
            </div>
        }

        <!-- 1. Digital Campus ID Card -->
        <div class="card salla-card p-3 mb-3 border-0 shadow-sm" 
             style="background: linear-gradient(135deg, #ffffff 0%, var(--brand-mint-soft) 100%); border: 1px solid rgba(0, 229, 163, 0.25) !important;">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-xs text-white flex-shrink-0" 
                         style="width: 50px; height: 50px; background: linear-gradient(135deg, var(--brand-midnight) 0%, #1e1b40 100%); font-size: 1.35rem;">
                        @(string.IsNullOrEmpty(Model.fullName) ? "ز" : Model.fullName.Substring(0, 1))
                    </div>
                    <div>
                        <h5 class="fw-bold m-0 d-flex align-items-center gap-2">
                            <span>@Model.fullName</span>
                            @if (Model.isVerified)
                            {
                                <span class="badge rounded-pill badge-cyan-verified px-2 py-1" style="font-size: 0.68rem;">طالب موثق ✓</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-dark rounded-pill px-2 py-1" style="font-size: 0.68rem;">
                                    غير موثق (3 إعلانات)
                                </span>
                            }</h5>
                        <span class="text-muted small">@Model.email</span>
                    </div>
                </div>

                <!-- Rating -->
                <div class="text-end">
                    <span class="badge bg-white text-dark border px-2 py-1 shadow-xs" style="font-size: 0.85rem;">
                        ⭐ @(Model.averageRating > 0 ? Model.averageRating.ToString("F1") : "جديد")
                    </span>
                    <div class="text-muted" style="font-size: 0.65rem;">(@Model.totalReviewsCount تقييم)</div>
                </div>
            </div>

            <!-- Academic Affiliation -->
            <div class="pt-2 border-top d-flex flex-wrap gap-2 text-muted" style="font-size: 0.82rem;">
                <span class="salla-badge-campus">🏛️ @(Model.universityName ?? "لم تحدد الجامعة")</span>
                @if (!string.IsNullOrEmpty(Model.facultyName))
                {
                    <span class="badge bg-white border text-dark rounded-pill px-2 py-1">@Model.facultyName</span>
                }
                @if (!string.IsNullOrEmpty(Model.majorName))
                {
                    <span class="badge bg-white border text-muted rounded-pill px-2 py-1">@Model.majorName</span>
                }
                @if (!string.IsNullOrEmpty(Model.studentRegNo))
                {
                    <span class="badge bg-white border font-monospace text-primary rounded-pill px-2 py-1">رقم القيد: @Model.studentRegNo</span>
                }
            </div>
        </div>

        <!-- 2. Quota Management Card with Quota Ring Visual -->
        @{
            var percent = (int)(((double)Model.activeListingsCount / Model.maxAllowedListings) * 100);
            var circumference = 151;
            var dashOffset = circumference - (circumference * Math.Min(percent, 100) / 100);
        }
        <div class="card salla-card p-3 mb-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="quota-ring-wrap flex-shrink-0">
                        <svg class="quota-ring-svg" width="64" height="64" viewBox="0 0 64 64">
                            <circle class="quota-ring-circle-bg" cx="32" cy="32" r="24"></circle>
                            <circle class="quota-ring-circle-val @(percent >= 100 ? "quota-ring-val-warning" : "")" 
                                    cx="32" cy="32" r="24"
                                    stroke-dasharray="151" 
                                    stroke-dashoffset="@dashOffset"></circle>
                        </svg>
                        <span class="quota-ring-text">@Model.activeListingsCount/@Model.maxAllowedListings</span>
                    </div>

                    <div>
                        <h6 class="fw-bold mb-1" style="color: var(--brand-midnight); font-size: 0.95rem;">
                            حصة النشر المتاحة (Quota Ring)
                        </h6>
                        <p class="text-muted small mb-0" style="font-size: 0.8rem;">
                            المتبقي لك الآن: <strong style="color: var(--brand-midnight);">@Model.remainingQuota</strong> إعلانات نشطة من أصل @Model.maxAllowedListings.
                        </p>
                    </div>
                </div>

                <div>
                    @if (!Model.isVerified)
                    {
                        <span class="badge rounded-pill bg-light border text-muted px-2 py-1" style="font-size: 0.72rem;">
                            سقف غير الموثق: 3
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill badge-cyan-verified px-2 py-1" style="font-size: 0.72rem;">
                            سقف الموثق: 5 ✓
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- 3. Student Verification Card (Academic Credentials - No Photos / 100% Privacy) -->
        @if (!Model.isVerified)
        {
            @if (!string.IsNullOrEmpty(Model.studentRegNo))
            {
                <div class="card salla-card p-3 mb-3 shadow-sm" style="background-color: var(--salla-primary-light); border: 1px solid var(--salla-mint-light) !important;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fs-5">⏳</span>
                        <h6 class="fw-bold small m-0" style="color: var(--salla-primary);">طلب التوثيق قيد المراجعة الأكاديمية</h6>
                    </div>
                    <p class="text-muted small mb-2" style="font-size: 0.82rem;">
                        تم إرسال بياناتك بنجاح: جامعة <strong>@(Model.universityName ?? "المحددة")</strong> • كلية <strong>@(Model.facultyName ?? "المحددة")</strong> • رقم القيد الأكاديمي: <strong class="font-monospace text-primary">@Model.studentRegNo</strong>.
                    </p>
                    <span class="badge bg-warning-subtle text-dark rounded-pill px-3 py-1 align-self-start" style="font-size: 0.72rem;">
                        جاري مطابقة رقم القيد من إدارة النظام لتفعيل شارة التوثيق
                    </span>
                </div>
            }
            else
            {
                <div class="card salla-card p-3 p-md-4 mb-3 shadow-sm" style="background-color: var(--primary-light); border: 1px dashed var(--brand-mint) !important;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="fs-4">🎓</span>
                            <h6 class="fw-bold small m-0" style="color: var(--salla-primary);">توثيق القيد الأكاديمي وترقية الكوتا إلى 5 إعلانات</h6>
                        </div>
                        <span class="badge rounded-pill px-2 py-1 text-white" style="background-color: var(--salla-mint); font-size: 0.68rem;">خصوصية 100% 🔒</span>
                    </div>
                    <p class="text-muted small mb-3" style="font-size: 0.8rem;">
                        أدخل بيانات قيدك الجامعي للحصول على شارة التوثيق الزرقاء ورفع سقف إعلاناتك من 3 إلى 5 مجاناً. <strong>(لا نطلب أي صور شخصية أو بطاقات إطلاقاً حفاظاً على الخصوصية التامة)</strong>.
                    </p>

                    <form asp-action="SubmitVerification" method="post" class="d-flex flex-column gap-3">
                        @Html.AntiForgeryToken()

                        <div>
                            <label class="form-label small fw-semibold" style="color: var(--salla-primary);">الجامعة المقيد بها <span class="text-danger">*</span></label>
                            <select id="verifyUniSelect" name="universityId" class="form-select rounded-3" required>
                                <option value="">-- اختر جامعتك --</option>
                                @if (ViewBag.Universities != null)
                                {
                                    foreach (var uni in (List<UniversityDto>)ViewBag.Universities)
                                    {
                                        <option value="@uni.id">@uni.name (@uni.city)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="row g-2">
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold" style="color: var(--salla-primary);">الكلية التابع لها <span class="text-danger">*</span></label>
                                <select id="verifyFacSelect" name="facultyId" class="form-select rounded-3" required>
                                    <option value="">-- اختر الكلية --</option>
                                </select>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold" style="color: var(--salla-primary);">القسم / التخصص الأكاديمي</label>
                                <select id="verifyMajorSelect" name="majorId" class="form-select rounded-3">
                                    <option value="">-- عام أو اختر التخصص --</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="form-label small fw-semibold" style="color: var(--salla-primary);">رقم القيد الجامعي (Reg. No) <span class="text-danger">*</span></label>
                            <input type="text" name="studentRegNo" class="form-control rounded-3 font-monospace" placeholder="مثال: 20220419" required />
                            <span class="text-muted" style="font-size: 0.72rem;">رقم القيد الأكاديمي الصادر من عمادة القبول والتسجيل.</span>
                        </div>

                        <button type="submit" class="btn-salla-mint rounded-pill px-4 py-2 mt-1 shadow-xs align-self-start">
                            <span>إرسال بيانات التوثيق الأكاديمي</span>
                            <span>✓</span>
                        </button>
                    </form>
                </div>
            }
        }

        <!-- 4. My Listings Management (إعلاناتي) -->
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h6 class="fw-bold m-0 text-dark">📦 إعلاناتي ومستلزماتي المعروضة (@Model.myListings.Count)</h6>
            <a asp-controller="Listings" asp-action="Create" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold text-decoration-none">
                ➕ إضافة جديد
            </a>
        </div>

        @if (Model.myListings.Count > 0)
        {
            <div class="d-flex flex-column gap-2">
                @foreach (var item in Model.myListings)
                {
                    <div class="card salla-card p-2 d-flex flex-row align-items-center justify-content-between gap-2 shadow-xs">
                        <!-- Thumbnail & Title -->
                        <div class="d-flex align-items-center gap-2 text-truncate">
                            @if (!string.IsNullOrEmpty(item.primaryImageUrl))
                            {
                                <img src="@item.primaryImageUrl" class="rounded-3 border" style="width: 50px; height: 50px; object-fit: cover;" alt="@item.title" />
                            }
                            else
                            {
                                <div class="rounded-3 border d-flex align-items-center justify-content-center p-1" style="width: 50px; height: 50px; background: rgba(19, 17, 43, 0.03);">
                                    <img src="~/images/zameel-brand-icon.png" style="width: 32px; height: 32px; object-fit: contain;" alt="شعار زميل" />
                                </div>
                            }

                            <div class="text-truncate">
                                <a asp-controller="Listings" asp-action="Details" asp-route-id="@item.id" 
                                   class="fw-bold text-dark text-decoration-none small text-truncate d-block">
                                    @item.title
                                </a>
                                <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                <span class="fw-bold small" style="color: var(--salla-primary); font-size: 0.8rem;">
                                    @(item.price > 0 ? item.price.ToString("N0") + " ريال يمني" : "مجاني")
                                </span>
                                @if (item.status == ListingStatus.PendingConfirmation)
                                {
                                    <span class="badge bg-warning-subtle text-dark border px-2 py-0 rounded-pill" style="font-size: 0.68rem;">
                                        ⏳ معلق (بانتظار تأكيد: @(item.pickupStoreName ?? "المكتبة الجامعية"))
                                    </span>
                                }
                                else if (item.status == ListingStatus.Active)
                                {
                                    <span class="badge bg-success-subtle text-success border px-2 py-0 rounded-pill" style="font-size: 0.68rem;">
                                        ✓ متاح في السوق @(item.pickupStoreName != null ? $"({item.pickupStoreName})" : "")
                                    </span>
                                }
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1" 
                                    style="font-size: 0.72rem;" onclick="markSold('@item.id')">
                                تم البيع ✅
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" 
                                    style="font-size: 0.72rem;" onclick="renewListing('@item.id')">
                                تجديد 🔄
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card salla-card text-center py-3 px-3 shadow-xs">
                <p class="text-muted small mb-2">ليس لديك أي إعلانات نشطة حالياً.</p>
                <div>
                    <a asp-controller="Listings" asp-action="Create" class="btn-salla-mint px-4 py-2 text-decoration-none">
                        <span>➕ نشر أول مستلزم لك الآن</span>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    // Academic Cascading for Profile Verification
    const verifyUniSelect = document.getElementById('verifyUniSelect');
    const verifyFacSelect = document.getElementById('verifyFacSelect');
    const verifyMajorSelect = document.getElementById('verifyMajorSelect');

    if (verifyUniSelect && verifyFacSelect) {
        verifyUniSelect.addEventListener('change', async function () {
            const uniId = this.value;
            verifyFacSelect.innerHTML = '<option value="">جاري التحميل...</option>';
            if (verifyMajorSelect) {
                verifyMajorSelect.innerHTML = '<option value="">-- عام أو اختر التخصص --</option>';
            }

            if (!uniId) {
                verifyFacSelect.innerHTML = '<option value="">-- اختر الكلية --</option>';
                return;
            }

            try {
                const res = await fetch(`/academic-catalog/faculties?universityId=${uniId}`);
                const json = await res.json();
                if (json.isSuccess && json.data.length > 0) {
                    let options = '<option value="">-- اختر الكلية --</option>';
                    json.data.forEach(f => {
                        options += `<option value="${f.id}">${f.displayName}</option>`;
                    });
                    verifyFacSelect.innerHTML = options;
                } else {
                    verifyFacSelect.innerHTML = '<option value="">لا توجد كليات مسجلة لهذه الجامعة</option>';
                }
            } catch (err) {
                verifyFacSelect.innerHTML = '<option value="">خطأ في جلب الكليات</option>';
            }
        });

        verifyFacSelect.addEventListener('change', async function () {
            if (!verifyMajorSelect) return;
            const facultyId = this.value;
            verifyMajorSelect.innerHTML = '<option value="">جاري التحميل...</option>';

            if (!facultyId) {
                verifyMajorSelect.innerHTML = '<option value="">-- عام أو اختر التخصص --</option>';
                return;
            }

            try {
                const res = await fetch(`/academic-catalog/majors?facultyId=${facultyId}`);
                const json = await res.json();
                if (json.isSuccess && json.data.length > 0) {
                    let options = '<option value="">-- عام أو اختر التخصص --</option>';
                    json.data.forEach(m => {
                        options += `<option value="${m.id}">${m.name}</option>`;
                    });
                    verifyMajorSelect.innerHTML = options;
                } else {
                    verifyMajorSelect.innerHTML = '<option value="">لا توجد تخصصات مسجلة لهذه الكلية</option>';
                }
            } catch (err) {
                verifyMajorSelect.innerHTML = '<option value="">خطأ في جلب التخصصات</option>';
            }
        });
    }

    async function markSold(listingId) {
        if (!confirm('هل تم بيع المستلزم بالفعل؟ سيتم تفريغ مساحة في رصيد إعلاناتك النشطة.')) return;

        try {
            const res = await fetch(`/listings/${listingId}/mark-sold`, { method: 'POST' });
            const data = await res.json();
            if (data.isSuccess) {
                alert(data.message || 'تم تحديث الإعلان كمباع بنجاح!');
                location.reload();
            } else {
                alert(data.message || 'حدث خطأ.');
            }
        } catch (e) {
            alert('تعذر الاتصال بالخادم.');
        }
    }

    async function renewListing(listingId) {
        try {
            const res = await fetch(`/listings/${listingId}/renew`, { method: 'POST' });
            const data = await res.json();
            if (data.isSuccess) {
                alert('تم تجديد الإعلان لمدة 30 يوماً إضافية!');
                location.reload();
            } else {
                alert(data.message || 'حدث خطأ.');
            }
        } catch (e) {
            alert('تعذر الاتصال بالخادم.');
        }
    }
</script>
}
