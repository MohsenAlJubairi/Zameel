@model ListingDetailsDto
@{
    ViewData["Title"] = Model.title;
    var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var sharePrice = Model.price > 0 ? $"{Model.price:N0} ريال يمني" : "مجاناً";
    var shareText = Uri.EscapeDataString($"معروض في زميل: {Model.title} ({sharePrice})\nرابط التفاصيل: {currentUrl}");
    
    var conditionText = Model.condition switch
    {
        ItemCondition.New => "جديد",
        ItemCondition.LikeNew => "ممتاز",
        _ => "مستعمل"
    };

    var conditionBadgeClass = Model.condition switch
    {
        ItemCondition.New => "bg-success-subtle text-success border border-success-subtle",
        ItemCondition.LikeNew => "bg-primary-subtle text-primary border border-primary-subtle",
        _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
    };
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-7">
        <!-- Top Navigation Bar -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-light border rounded-pill px-3 d-inline-flex align-items-center gap-1 text-decoration-none">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                <span>العودة للمتجر</span>
            </a>
            <span class="text-muted small">نُشر @Model.createdAt.ToString("yyyy/MM/dd")</span>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 border-0 shadow-xs d-flex align-items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 shadow-xs d-flex align-items-center gap-2">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="card salla-card overflow-hidden shadow-sm mb-3 border-0" style="border-radius: var(--radius-xl);">
            <!-- 1. Product Image Carousel -->
            @if (Model.imageUrls.Count > 0)
            {
                <div id="listingCarousel" class="carousel slide bg-light" data-bs-ride="carousel" style="border-bottom: 1px solid var(--border-color);">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.imageUrls.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "") text-center" style="max-height: 420px; min-height: 280px; background-color: #fafbfc;">
                                <img src="@Model.imageUrls[i]" class="d-block w-100" style="object-fit: contain; max-height: 420px;" alt="@Model.title" />
                            </div>
                        }
                    </div>
                    @if (Model.imageUrls.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon bg-dark bg-opacity-50 rounded-circle p-2" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon bg-dark bg-opacity-50 rounded-circle p-2" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center py-4 text-center" style="min-height: 200px; border-bottom: 1px solid var(--border-color); background: #f1f0eb;">
                    <img src="~/images/zameel-brand-icon.png" class="mb-2" style="max-width: 170px; max-height: 170px; object-fit: contain;" alt="شعار زميل" />
                    <span class="text-muted small">مستلزم معروض بدون صور مرفقة</span>
                </div>
            }

            <!-- 2. Product Details & Content -->
            <div class="card-body p-3">
                <!-- Academic Tags Pill Row -->
                <div class="d-flex flex-wrap align-items-center gap-1 mb-2">
                    <span class="salla-badge-campus">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        @Model.universityName
                    </span>
                    @if (!string.IsNullOrEmpty(Model.primaryFacultyName))
                    {
                        <span class="badge rounded-pill bg-light text-dark border px-2 py-1" style="font-size: 0.72rem;">@Model.primaryFacultyName</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.primaryMajorName))
                    {
                        <span class="badge rounded-pill bg-light text-muted border px-2 py-1" style="font-size: 0.72rem;">@Model.primaryMajorName</span>
                    }
                    @if (Model.type == ListingType.Donation)
                    {
                        <span class="badge rounded-pill px-2 py-1" style="background-color: var(--brand-mint); color: var(--brand-midnight); font-size: 0.72rem;">تبرع / إهداء</span>
                    }
                    else if (Model.type == ListingType.Request)
                    {
                        <span class="badge rounded-pill px-2 py-1" style="background-color: var(--brand-saffron); color: var(--brand-midnight); font-size: 0.72rem;">مطلوب</span>
                    }
                </div>

                <!-- Title & Price Block -->
                <div class="d-flex flex-column flex-sm-row sm-align-items-center justify-content-between gap-2 mb-3 pb-3 border-bottom">
                    <h1 class="fs-4 fw-bold m-0" style="color: var(--text-main); line-height: 1.4;">@Model.title</h1>
                    <div class="flex-shrink-0 text-start">
                        @if (Model.price == 0 || Model.type == ListingType.Donation)
                        {
                            <span class="badge fs-5 px-3 py-1 rounded-pill fw-bold" style="background: rgba(0, 229, 163, 0.15); color: #087550;">مجاناً</span>
                        }
                        else
                        {
                            <div class="d-flex align-items-baseline gap-1" style="color: var(--brand-midnight);">
                                <span class="fs-2 fw-bold">@Model.price.ToString("N0")</span>
                                <span class="fw-semibold small text-muted">ريال يمني</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- 3. Key Specifications Bento Box (حالة المستلزم + نقطة التسليم + الموقع) -->
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-4">
                        <div class="p-2 px-3 rounded-3 border bg-light h-100">
                            <span class="text-muted d-block" style="font-size: 0.72rem;">حالة المستلزم</span>
                            <span class="badge @conditionBadgeClass rounded-pill mt-1" style="font-size: 0.76rem;">@conditionText</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="p-2 px-3 rounded-3 border bg-light h-100">
                            <span class="text-muted d-block" style="font-size: 0.72rem;">طريقة ونقطة الاستلام</span>
                            @if (!string.IsNullOrEmpty(Model.pickupStoreName))
                            {
                                <span class="fw-semibold small text-dark d-block mt-1 text-truncate" title="@Model.pickupStoreName">
                                    🏪 @Model.pickupStoreName
                                </span>
                            }
                            else
                            {
                                <span class="fw-semibold small text-dark d-block mt-1">يداً بيد داخل الحرم</span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="p-2 px-3 rounded-3 border bg-light h-100">
                            <span class="text-muted d-block" style="font-size: 0.72rem;">الحرم الجامعي</span>
                            <span class="fw-semibold small text-dark d-block mt-1 text-truncate">@Model.universityName</span>
                        </div>
                    </div>
                </div>

                <!-- 4. Mandatory Campus Bookstore Pickup Hub Badge -->
                @if (!string.IsNullOrEmpty(Model.pickupStoreName))
                {
                    <div class="p-3 rounded-4 mb-4 border" style="background: rgba(0, 229, 163, 0.08); border-color: rgba(0, 229, 163, 0.35) !important;">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fs-4">🏪</span>
                            <div>
                                <h6 class="fw-bold m-0" style="color: var(--brand-midnight);">نقطة الاستلام المعتمدة: @Model.pickupStoreName</h6>
                                <span class="text-muted small">هذا المستلزم مودع ومفحوص لدى المكتبة وجاهز للمعاينة والاستلام فوراً.</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.pickupStoreLocation))
                        {
                            <div class="mt-2 p-2 rounded-3 bg-white border small text-muted d-flex align-items-center gap-2">
                                <span>📍</span>
                                <span><strong>موقع المكتبة داخل الحرم:</strong> @Model.pickupStoreLocation</span>
                            </div>
                        }
                    </div>
                }

                <!-- Description & Details -->
                <div class="mb-4">
                    <h6 class="fw-bold small mb-2" style="color: var(--brand-midnight);">تفاصيل المستلزم وملاحظات الاستلام:</h6>
                    <div class="p-3 bg-light rounded-3 text-dark border" style="white-space: pre-line; line-height: 1.8; font-size: 0.95rem; border-color: var(--border-color) !important;">
                        @Model.description
                    </div>
                </div>

                <!-- Seller Profile Card -->
                <div class="p-3 rounded-4 mb-4 d-flex align-items-center justify-content-between border" style="background-color: var(--brand-mint-soft); border-color: rgba(0, 229, 163, 0.3) !important;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-xs text-white" 
                             style="width: 50px; height: 50px; background: var(--brand-midnight); font-size: 1.25rem;">
                            @(string.IsNullOrEmpty(Model.sellerName) ? "ز" : Model.sellerName.Substring(0, 1))
                        </div>
                        <div>
                            <div class="fw-bold d-flex align-items-center gap-1" style="color: var(--brand-midnight);">
                                <span>@Model.sellerName</span>
                                @if (Model.sellerIsVerified)
                                {
                                    <span class="badge rounded-pill badge-cyan-verified px-2 py-0" style="font-size: 0.65rem;">طالب موثق ✓</span>
                                }
                            </div>
                            <span class="text-muted small">@Model.universityName</span>
                        </div>
                    </div>

                    <!-- Chat & Contact Actions -->
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Chat" asp-action="Thread" asp-route-otherUserId="@Model.sellerId" asp-route-listingId="@Model.id"
                           class="btn-salla-mint px-3 py-2 fs-6 shadow-xs text-decoration-none d-flex align-items-center gap-2">
                            <span>💬</span>
                            <span>مراسلة الزميل</span>
                        </a>
                        <a href="#commentsSection" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-2 text-decoration-none d-flex align-items-center gap-1">
                            <span>التعليقات</span>
                        </a>
                        @if (!string.IsNullOrEmpty(Model.sellerPhone))
                        {
                            <a href="https://api.whatsapp.com/send?phone=@Model.sellerPhone&text=@Uri.EscapeDataString($"مرحباً زميلي، بخصوص عرضك في زميل: {Model.title}")" 
                                target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 py-2 d-none d-sm-inline-flex align-items-center gap-1">
                                <span>واتساب</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Campus Safety Notice -->
                <div class="p-2 px-3 bg-light rounded-3 mb-3 d-flex align-items-center gap-2 text-muted" style="font-size: 0.78rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    <span><strong>نظام أمان زميل المعتمد:</strong> يتم استلام هذا المستلزم عبر نقطة الاستلام المعتمدة داخل الحرم الجامعي حفاظاً على خصوصية وأمان الجميع.</span>
                </div>

                <!-- Share & Moderation Actions -->
                <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                    <!-- WhatsApp Share -->
                    <a href="https://api.whatsapp.com/send?text=@shareText" 
                       target="_blank" class="btn btn-outline-success rounded-pill flex-grow-1 py-2 text-decoration-none d-flex align-items-center justify-content-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
                        <span>مشاركة العرض على واتساب</span>
                    </a>

                    <!-- Community Report Sold -->
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 py-2" onclick="reportAsSold('@Model.id')">
                        الإبلاغ أنه بيع
                    </button>
                </div>
            </div>
        </div>

        <!-- 5. Public Comments & Inquiries Bento Section (التعليقات والاستفسارات العامة) -->
        <div class="card salla-card p-3 mb-3 shadow-sm" id="commentsSection">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4">💬</span>
                    <div>
                        <h6 class="fw-bold m-0" style="color: var(--brand-midnight);">
                            الاستفسارات والتعليقات العامة (@(Model.comments?.Count ?? 0))
                        </h6>
                        <span class="text-muted" style="font-size: 0.76rem;">اسأل البائع أو المكتبة حول مواصفات المستلزم، وضوح الأوراق، أو الاستلام.</span>
                    </div>
                </div>
            </div>

            <!-- Add New Comment Box -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Comments" asp-action="Add" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="listingId" value="@Model.id" />
                    <div class="mb-2">
                        <textarea name="content" class="form-control rounded-3" rows="2" 
                                  placeholder="اكتب استفسارك أو سؤالك حول هذا المستلزم..." required maxlength="1000"></textarea>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn-salla-mint px-4 py-1 fs-6 shadow-xs">
                            <span>إرسال التعليق</span>
                            <span>💬</span>
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="p-3 rounded-3 bg-light text-center border mb-4">
                    <span class="text-muted small">هل لديك سؤال حول هذا المستلزم؟</span>
                    <div class="mt-2">
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn-salla-mint px-3 py-1 small text-decoration-none">
                            تسجيل الدخول لطرح استفسار
                        </a>
                    </div>
                </div>
            }

            <!-- Comments List -->
            @if (Model.comments != null && Model.comments.Count > 0)
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var comment in Model.comments)
                    {
                        <div class="p-3 rounded-4 bg-light border">
                            <!-- Comment Author & Meta -->
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-xs text-white" 
                                         style="width: 32px; height: 32px; background: var(--brand-midnight); font-size: 0.85rem;">
                                        @(string.IsNullOrEmpty(comment.authorName) ? "ز" : comment.authorName.Substring(0, 1))
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                            <span class="fw-bold small text-dark">@comment.authorName</span>
                                            @if (comment.isSeller)
                                            {
                                                <span class="badge rounded-pill bg-primary text-white" style="font-size: 0.65rem;">صاحب العرض</span>
                                            }
                                            @if (comment.authorRole == "STORE" || comment.authorRole == "Store" || comment.authorRole.Contains("مكتبة"))
                                            {
                                                <span class="badge rounded-pill badge-cyan-verified" style="font-size: 0.65rem;">المكتبة 🏪</span>
                                            }
                                            @if (comment.isAuthorVerified)
                                            {
                                                <span class="salla-verified-badge" title="طالب موثق">✓</span>
                                            }
                                        </div>
                                        <span class="text-muted" style="font-size: 0.7rem;">@comment.createdAt.ToString("yyyy/MM/dd HH:mm")</span>
                                    </div>
                                </div>

                                <!-- Actions (Reply & Delete) -->
                                <div class="d-flex align-items-center gap-2">
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <button type="button" class="btn btn-sm btn-link text-muted p-0 text-decoration-none" 
                                                style="font-size: 0.75rem;" onclick="toggleReplyBox('@comment.id')">
                                            رد ↩️
                                        </button>
                                    }
                                    @if (comment.canDelete)
                                    {
                                        <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.id" method="post" 
                                              class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا التعليق؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="listingId" value="@Model.id" />
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" style="font-size: 0.75rem;">
                                                حذف 🗑️
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>

                            <!-- Comment Body -->
                            <p class="mb-2 text-dark small" style="white-space: pre-line; line-height: 1.6;">@comment.content</p>

                            <!-- Reply Input Form (Hidden by default) -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div id="replyBox-@comment.id" class="d-none mt-2 pt-2 border-top">
                                    <form asp-controller="Comments" asp-action="Add" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="listingId" value="@Model.id" />
                                        <input type="hidden" name="parentCommentId" value="@comment.id" />
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="content" class="form-control rounded-start-3" 
                                                   placeholder="اكتب ردك على @comment.authorName..." required maxlength="1000" />
                                            <button type="submit" class="btn-salla-mint px-3 rounded-end-3">إرسال الرد</button>
                                        </div>
                                    </form>
                                </div>
                            }

                            <!-- Replies Thread -->
                            @if (comment.replies != null && comment.replies.Count > 0)
                            {
                                <div class="mt-2 pt-2 border-top d-flex flex-column gap-2 ms-3 pe-2 border-start ps-3" style="border-left-width: 2px !important; border-left-color: var(--brand-mint) !important;">
                                    @foreach (var reply in comment.replies)
                                    {
                                        <div class="p-2 rounded-3 bg-white border">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                                    <span class="fw-bold small text-dark" style="font-size: 0.8rem;">@reply.authorName</span>
                                                    @if (reply.isSeller)
                                                    {
                                                        <span class="badge rounded-pill bg-primary text-white" style="font-size: 0.6rem;">صاحب العرض</span>
                                                    }
                                                    @if (reply.authorRole == "STORE" || reply.authorRole == "Store" || reply.authorRole.Contains("مكتبة"))
                                                    {
                                                        <span class="badge rounded-pill badge-cyan-verified" style="font-size: 0.6rem;">المكتبة 🏪</span>
                                                    }
                                                    @if (reply.isAuthorVerified)
                                                    {
                                                        <span class="salla-verified-badge" title="طالب موثق">✓</span>
                                                    }
                                                    <span class="text-muted" style="font-size: 0.68rem;">• @reply.createdAt.ToString("yyyy/MM/dd HH:mm")</span>
                                                </div>

                                                @if (reply.canDelete)
                                                {
                                                    <form asp-controller="Comments" asp-action="Delete" asp-route-id="@reply.id" method="post" 
                                                          class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا الرد؟');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="listingId" value="@Model.id" />
                                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" style="font-size: 0.7rem;">
                                                            🗑️
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                            <p class="mb-0 text-dark small" style="white-space: pre-line; line-height: 1.5; font-size: 0.84rem;">@reply.content</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <span class="fs-2 d-block mb-1">💬</span>
                    <span class="small">لا توجد استفسارات أو تعليقات حتى الآن. كن أول من يسأل البائع أو المكتبة!</span>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleReplyBox(commentId) {
        const box = document.getElementById('replyBox-' + commentId);
        if (box) {
            box.classList.toggle('d-none');
        }
    }

    async function reportAsSold(listingId) {
        if (!confirm('هل تأكدت أن هذا المستلزم تم بيعه لتحديث بيانات السوق للزملاء؟')) return;

        try {
            const res = await fetch(`/listings/${listingId}/report-sold`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            const data = await res.json();
            if (data.isSuccess) {
                alert(data.message || 'شكراً لتعاونك! تم تسجيل بلاغك بنجاح.');
                location.reload();
            } else {
                alert(data.message || 'حدث خطأ.');
            }
        } catch (e) {
            alert('تعذر إرسال الإبلاغ.');
        }
    }
</script>
}
